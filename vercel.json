{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "functions": {
    "api/chat.js": {
      "includeFiles": "data/site-knowledge.json",
      "maxDuration": 25
    }
  },
  "redirects": [
    {
      "source": "/assets/images/aayam-portrait-1.jpg",
      "destination": "/assets/images/aayam-paudel-web-developer-nepal.jpg",
      "permanent": true
    },
    {
      "source": "/assets/images/aayam-portrait-2.jpg",
      "destination": "/assets/images/aayam-paudel-working-on-laptop.jpeg",
      "permanent": true
    },
    {
      "source": "/assets/images/aayam-working-laptop.jpeg",
      "destination": "/assets/images/aayam-paudel-working-on-laptop.jpeg",
      "permanent": true
    },
    {
      "source": "/assets/images/project-haat-bazzar.jpg",
      "destination": "/assets/images/aayam-paudel-haat-bazzar-marketplace.jpg",
      "permanent": true
    },
    {
      "source": "/assets/images/project-municipal.jpg",
      "destination": "/assets/images/aayam-paudel-citizenship-recommendation-portal.jpg",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/api/contact",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "POST, OPTIONS"
        }
      ]
    },
    {
      "source": "/api/chat",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "POST, OPTIONS"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; object-src 'none'; script-src 'self' 'sha256-zfQvHbMy9APWTs9y2iQpLZCeP3TpIBEh0cEFMnXzSTY=' 'sha256-OOKUcuXncH9CcDFcbZuJLf4VzDBcFHZHa28fEJrzqAo='; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https://avatars.githubusercontent.com; media-src 'self'; connect-src 'self' https://countapi.mileshilliard.com https://api.github.com; manifest-src 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), geolocation=(), microphone=(), payment=(), usb=()"
        }
      ]
    }
  ]
}
