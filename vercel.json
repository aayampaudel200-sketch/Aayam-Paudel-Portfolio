    },
    {
      "source": "/assets/images/namaste suman 2.jpg",
      "destination": "/assets/images/namaste-suman-service-counter.jpg",
      "permanent": true
    },
    {
      "source": "/assets/images/namaste%20suman%202.jpg",
      "destination": "/assets/images/namaste-suman-service-counter.jpg",
